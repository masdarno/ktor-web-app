KTOR_HOST=127.0.0.1
KTOR_PORT=8080
KTOR_DEVELOPMENT=true

APP_BASE_URL=http://127.0.0.1:8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TYPE=mariadb

STORAGE_TYPE=local # Opsi: "local" atau "s3"
STORAGE_BASE_PATH=uploads # Folder induk untuk semua modul

MAIL_FROM=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_AUTH=true

# Gunakan hex string yang panjang dan unik
SESSION_ENCRYPT_KEY=
SESSION_SIGN_KEY=

COOKIE_SECURE=false # Set true jika menggunakan HTTPS
CSRF_ALLOW_ORIGIN=http://127.0.0.1:8080

REMEMBER_ME_PEPPER=

USER_PROFILE_DIR=profile
USER_PHOTO_MAX_SIZE_MB=2
USER_PHOTO_UPLOAD_DIR=uploads/profile
USER_PHOTO_DEFAULT_DIR=/assets/img/avatars
