<jasperTemplate>
	<style name="Base" forecolor="#000000" backcolor="#FFFFFF" fontName="Arial" fontSize="10.0">
		<box padding="5"/>
	</style>
	<style name="TableHeader" style="Base" mode="Opaque" backcolor="#D3D3D3" hTextAlign="Center" vTextAlign="Middle" bold="true">
		<box style="Base">
			<topPen lineWidth="1.0"/>
			<leftPen lineWidth="1.0"/>
			<bottomPen lineWidth="1.0"/>
			<rightPen lineWidth="1.0"/>
		</box>
	</style>
	<style name="TableCell" style="Base">
		<box style="Base">
			<topPen lineWidth="1.0"/>
			<leftPen lineWidth="1.0"/>
			<bottomPen lineWidth="1.0"/>
			<rightPen lineWidth="1.0"/>
		</box>
	</style>
	<style name="ReportTitle" style="Base" mode="Transparent" backcolor="#D3D3D3" hTextAlign="Center" vTextAlign="Middle" fontSize="14.0" bold="true">
		<box style="Base">
			<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
			<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
		</box>
	</style>
</jasperTemplate>
