	<template><![CDATA["shared/MY_STYLES.jrtx"]]></template>
	<query language="SQL"><![CDATA[select a.nama, username, email, (case when email_verified_at is not null then 'Terverifikasi' else '' end) verified, b.nama role
from users a
join roles b on a.role_id = b.id]]></query>
